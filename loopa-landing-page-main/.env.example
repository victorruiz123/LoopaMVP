# Server-side only — used by the Cloudflare Pages Function at
# functions/api/chat.ts. Never exposed to the client bundle.
# Configure these as Cloudflare Pages environment variables / secrets
# (Pages project → Settings → Environment variables), not in a committed .env.

# Google AI Studio API key for Gemini. If unset, /api/chat automatically
# falls back to deterministic local-demo answers so the UI stays testable.
GEMINI_API_KEY=

# Cheapest suitable Gemini Flash-Lite class model. Keep this configurable so
# it can be swapped without a code change as pricing/models evolve.
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional: route Gemini calls through a Cloudflare AI Gateway instead of
# calling generativelanguage.googleapis.com directly, e.g.
# https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_name>
AI_GATEWAY_URL=

# Used ONLY by functions/api/brand-preview.ts's own independent model
# routing. NOT read by functions/api/generate-listing.ts or the seller/*
# endpoints — those share functions/api/_shared/gemini.ts, which hardcodes
# gemini-3.7-flash (primary) / gemini-3.6-flash (fallback) in code, not via
# env vars, so model selection can't silently drift per-environment.
GEMINI_MODEL_PRIMARY=gemini-3.7-flash
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
