node_modules/
dist/
*.tsbuildinfo
.env
.DS_Store

# ML-korpusen ligger utanför versionshanteringen: 33 GB, med enskilda filer på upp
# till 9,9 GB. GitHub avvisar allt över 100 MB per fil, och Git LFS löser det inte —
# kvoten är 1 GB. Se README för hur den ska pekas ut lokalt.
Price_engine/vips-ml-data/

# Dev-certifikat med LAN-adress. Maskinspecifikt och byts vid nätverksbyte.
web/.certs/
tools/cloudflared
deploy/cloudflared/config.local.yml

# Originalen som scripts/set-account-price.mjs sparar undan före en prisskrivning.
# Kopior av riktiga jobb, med ägar-id och prisstegar — samma sort data som server/data/.
.price-backup/
bench/
bench-prov/

# Nedladdad kopia av repot (zip från GitHub). 370 MB som inte hör hemma i historiken — och som ett
# `git add -A` annars sväljer. Blocket-publiceringen som letades efter där ligger på grenen
# blocket-autopublicering, inte i mappen.
LoopaMVP-main/

# Blocket-sessionen: Playwrights storageState från en inloggning för hand (npm run blocket:logga-in),
# och den packade kopian som klistras in i serverns .env. Inloggade kakor — hör aldrig hemma i
# historiken, hur privat repot än är.
blocket-session.json
blocket-session.b64

# Blockets webbläsare. rulla-ut.sh installerar Chromium hit (PLAYWRIGHT_BROWSERS_PATH), alltså inuti
# repot, för att tjänsten och skriptet ska leta på samma ställe oavsett vem som kör. Utan den här
# raden ser skriptets egen kontroll i steg 1 mappen som en lokal ändring och avbryter NÄSTA
# utrullning — en spärr som utlöses av det förra steget i samma skript.
ms-playwright/
