# API-nyckel för bildklassningen (möbeltyp ur foto).
# Kopiera till .env och fyll i din nyckel:  cp .env.example .env
#
# Bildklassningen är valfri — utan nyckel fungerar prismotorn precis som
# vanligt, bara utan möbeltypsfilter.
OPENAI_API_KEY=

# Valfritt: byt modell. Default är gpt-4o-mini.
# VARIANT_MODEL=gpt-4o-mini

# --- Alternativ leverantör -------------------------------------------------
# Motorn talar OpenAI-protokoll men inte nödvändigtvis med OpenAI. Sätt de här
# tre för att peka om den. Vilken modell som svarat redovisas alltid i
# mätresultatet — en L3-siffra utan modellnamn betyder ingenting.
#
# Google AI Studio (gratisnivå, nyckeln går att läsa i gränssnittet):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=<nyckel från aistudio.google.com/apikey>
# VARIANT_MODEL=gemini-2.5-flash
#
# Lovables AI-gateway (samma modellfamilj, men nyckeln är write-only i Lovable
# Cloud och går därför inte att läsa ut — kräver en proxyfunktion i app-repot):
# AI_BASE_URL=https://ai.gateway.lovable.dev/v1
# AI_API_KEY=<LOVABLE_API_KEY>
# VARIANT_MODEL=google/gemini-2.5-flash
