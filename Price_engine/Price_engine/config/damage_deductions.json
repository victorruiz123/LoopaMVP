    "count_escalation_at": 3,
    "grade_0_threshold": "grad 0 ger alltid 0 % — listas för transparens, prissätts inte",
    "note": "Motorn läser dessa värden ur config, inte härifrån. Blocket hålls synkat med test."
  },
