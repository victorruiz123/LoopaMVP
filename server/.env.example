# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Produktforskningen (server/src/research) --------------------------------
# Identifiering och specifikationssökning med Gemini 3 genom Interactions API: Google Search + URL
# context + JSON-schema i samma anrop. Förval nedan; inget behöver sättas. Kvalitet först (docs/kvalitet-2026-10-25.md).
#
# "legacy" stänger av forskningen och går den gamla vägen genom annonsgeneratorn i
# loopa-landing-page-main (gemini-3.5-flash-lite, fritext + regex).
# LOOPA_RESEARCH_ENGINE=gemini3
#
# Modell. Ingen reservmodell: ett fall hanteras av anroparen.
# LOOPA_RESEARCH_MODEL=gemini-3.8-flash
#
# thinking_level: minimal | low | medium | high. Förvalet är "medium" (historiska baslinjen, den bäst mätta inställningen — se dokumentet).
# En enda sökrunda på "low" gav säkra fel (BÖRJE och NÄSINGE för NORRNÄS-stolen).
# LOOPA_IDENTIFY_THINKING=medium
# LOOPA_SPEC_THINKING=medium
#
# IDENTIFIERINGEN = högst LOOPA_IDENTIFY_MAX_ROUNDS omgångar i följd, var och en ETT modellanrop med ETT sökanrop av högst LOOPA_IDENTIFY_ROUND_QUERIES
# frågor (+ URL-verktyget). Varje omgång får förra omgångens fynd; en stark toppkandidat avslutar. Gränsen verkställs av KODEN: modellen följer
# inget antal sökfrågor som bara står i prompten (mätt 2026-10-25). Varje omgång lämnar ett svar, så en som faller kastar aldrig de tidigare.
# LOOPA_IDENTIFY_ROUND_QUERIES=5
# LOOPA_IDENTIFY_MAX_ROUNDS=3
# Specsökningen är ETT anrop med ETT sökanrop av så här många frågor; sidorna den läser bär det mesta (kostnaden är sidorna: ≈0,25 SEK per IKEA-sida).
# LOOPA_SPEC_SEARCH_BUDGET=6
# LOOPA_SPEC_MAX_START_PAGES=3
#
# KOSTNAD PER OMGÅNG (server/src/cost/ledger.ts). Allt betalt i en komplett omgång — identifiering, sökning, specar, skick, annonstext, varianter,
# omförsök och anrop som föll — bokförs på jobbet (GET /api/jobs/:id/cost). TVÅ SKILDA TAL:
#   MÅLET (≈2,00 SEK) är vad en typisk omgång ska kosta. Det rapporteras (overTarget) och tvingar ingenting.
#   SÄKERHETSBUDGETEN (förval 6,00 SEK) är det inställbara tak som skyddar mot okontrollerade utgifter: tillåtelserna räknas mot den, och är den slut
#   startas inget mer betalt arbete (det som finns levereras märkt som ofullständigt). Den är ingen garanti från leverantören — Googles sökavgift
#   (14 USD per 1 000 frågor) har ingen parameter per anrop; taket verkställs av oss på strömmen. Gratisnivån (5 000 sökningar per månad) räknas INTE in.
# LOOPA_ATTEMPT_TARGET_SEK=2.0
# LOOPA_ATTEMPT_BUDGET_SEK=6.0
# LOOPA_USD_SEK=11.0
#
# Googles eget tak på utdata inklusive tänkande per anrop (generation_config.max_output_tokens) — det enda token-tak tjänsten själv verkställer.
# Ett för snävt tak avkortar svaret (det kastade en hel specsökning 2026-10-25 när det var 12 000), så det ligger väl över ett normalt svar.
# LOOPA_IDENTIFY_MAX_OUTPUT_TOKENS=32000
# LOOPA_SPEC_MAX_OUTPUT_TOKENS=32000
#
# Skyddsnät för mätskript och anropare utan kostnadsbok (i en omgång gäller tillåtelsen ur boken): sökfrågor över alla omgångar.
# LOOPA_IDENTIFY_MAX_QUERIES=40
# LOOPA_SPEC_MAX_QUERIES=30
#
# LIVSLÄNGDER (ms) — skydd mot ett anrop som hänger sig, inte klockor säljaren tävlar mot. Säljaren väntar inte på dem: skick, frågor och pris går att
# göra medan modellförslagen letas fram. En svår, utgången modell kan ta två–tre minuter. RESERVE = tid som alltid lämnas kvar efter modellanropet
# (lösning av Googles omdirigeringar); MIN_CALL = minsta tid kvar för att en ny omgång eller ett omförsök efter ett tillfälligt fel ska startas.
# LOOPA_IDENTIFY_DEADLINE_MS=180000
# LOOPA_IDENTIFY_RESERVE_MS=4000
# LOOPA_IDENTIFY_MIN_CALL_MS=30000
# LOOPA_SPEC_TIMEOUT_MS=180000
#
# Inget snabbspår, ingen säkring, ingen reservmodell, ingen förvärmning: varje anrop är betalt arbete.
#
# Spår: ett JSON per Gemini-anrop i server/data/research-traces/ (sökfrågor, adresser, tider, tokens,
# försök, fel — aldrig bilder, nyckel eller prompt). 0 stänger av. Katalogen kan flyttas.
# LOOPA_RESEARCH_TRACE=1
# LOOPA_RESEARCH_TRACE_DIR=
#
# Bilder: upp till så många bildrutor, orörda upp till så många pixlar på längsta sidan, och
# media_resolution per bild (low | medium | high | ultra_high; high = 1120 tokens per bild).
# LOOPA_RESEARCH_MAX_IMAGES=6
# LOOPA_RESEARCH_IMAGE_MAX_SIDE=1600
# LOOPA_RESEARCH_IMAGE_RESOLUTION=high
#
# Verifiering mot källsidorna (egen hämtning, utanför modellen). 0 stänger av — då är inget mått
# "bekräftat", bara "citerat".
# LOOPA_PAGE_VERIFY=1
# LOOPA_PAGE_VERIFY_TIMEOUT_MS=8000
# LOOPA_PAGE_VERIFY_MAX_PAGES=6
# LOOPA_PAGE_VERIFY_BUDGET_MS=15000

# Verifierat faktaminne: ett slutfört specsvar sparas per märke+modell i 14 dagar, så nästa säljare av samma
# modell slipper en ny sökning. 0 stänger av. Det är ingen katalog och ingen identifieringsväg.
# LOOPA_FACTS_CACHE=1
# LOOPA_FACTS_CACHE_DIR=

# Public API (/v1/condition). Without it the API refuses every request — it never runs open.
# Generate one with:  openssl rand -hex 32
CONDITION_API_KEY=

# Optional — defaults shown
PORT=8799

# --- Prismotorn (Price_engine) --------------------------------------------
# Skickmotorn frågar prismotorn vad möbeln är värd GIVET skadorna. Är den inte
# igång blir svaret ett skickresultat utan pris — aldrig ett misslyckat jobb.
# Starta den med `npm run price:dev`.
PRICE_ENGINE_URL=http://127.0.0.1:8000

# Bara om prismotorn startats med PRICE_ENGINE_API_KEY satt.
# PRICE_ENGINE_API_KEY=

# Hur länge skickmotorn väntar på ett prissvar, i ms. Standard 45000.
# PRICE_ENGINE_TIMEOUT_MS=45000

# 1 = skicka en bildruta så prismotorn klassificerar möbeltypen ur den. AV som
# standard: det anropet görs utan timeout på Python-sidan och hänger. Typen
# härleds ändå ur modellnamnet.
# PRICE_ENGINE_USE_IMAGE=1

# --- Omslaget --------------------------------------------------------------
# Kortets bild är säljarens egen möbel, urklippt ur bildrutan och lagd på vitt
# (server/src/pipeline/bild/). Det kostar ingen extra modellavgift, och körs utanför
# säljarens väntan. Sätt till 0 för att stänga av det: kortet visar då bildrutan
# som den togs, precis som när urklippet inte går att göra.
# COVER_CUTOUT=0

# --- Tradera ---------------------------------------------------------------
# Publicerar truth-cardet som en riktig annons på Loopas Tradera-konto. Saknas
# någon av de fyra göms knappen i truth-cardet — integrationen är frånkopplad,
# inte trasig. Säljarens "Sälj med Loopa" ställer annonsen i kö; det är
# adminpanelens "Godkänn och lägg ut" (victor@ruiz.se, se ADMIN_EMAILS) som
# lägger ut den — i Butiken och på Tradera i samma tryck. Ett brev om varje ny
# köpost går till adminadresserna via utskicket (EMAIL_PROVIDER). App-id och app-key finns i Developer Center (Applications ->
# Keys); user-id och token faller ut ur token-login-steget.
TRADERA_APP_ID=
TRADERA_APP_KEY=
TRADERA_USER_ID=
TRADERA_USER_TOKEN=

# Valfria.
#
# Annonstyp. Standard är fast pris — "Endast Köp Nu" till priset på kortet.
# Sätt till "auction" om Tradera avvisar med "only auctions allowed": ett nytt
# eller obetygsatt privatkonto är restricted och får bara lägga upp auktioner.
# TRADERA_LISTING_MODE=fixed
#
# Auktionslängd i dagar, används bara när läget är "auction". Minst 7 på ett
# restricted konto. En Köp Nu-annons får sin längd av Tradera.
# TRADERA_AUCTION_DAYS=7
#
# Vilka betalsätt annonsen ska erbjuda. Standard är kontots enda aktiverade:
# 16384 = Swish / Kort / PayPal. Se GET /v4/users/me/payment-options.
# TRADERA_PAYMENT_OPTION_IDS=16384

# --- Prisstegen ------------------------------------------------------------
# Säljaren sätter ett startpris och ett golv på prisvyn, och servern sänker
# MÖBELNS pris 15 % i veckan tills golvet nås. Stegen är alltid på: butiken
# följer priset direkt, Tradera flyttas genom API:t och Blocket genom
# prisroboten (BLOCKET_PUBLICERA=1, se nedan) eller för hand ur panelen. En
# kanal som inte går att flytta bokförs som "ur fas" på annonsen och mejlas
# till ADMIN_EMAILS — den stoppar inte sänkningen. De två variablerna nedan
# finns bara för att kunna se hela förloppet i en demo utan att vänta en månad
# på fjärde steget.
#
# Tiden mellan två sänkningar. Standard: en vecka (604800000 ms).
# PRICE_LADDER_INTERVAL_MS=604800000
#
# Hur ofta servern tittar efter förfallna sänkningar. Standard: 15 min.
# PRICE_LADDER_TICK_MS=900000

# Signerar bildkakan som låter <img> hämta jobbets bildrutor. Utan den slumpas en per start, och
# kakorna slutar gälla vid varje omstart.  openssl rand -hex 32
MEDIA_COOKIE_SECRET=

# Maskinkonto för mätharnessen (tests/candidate-path.ts m.fl.). Skickas som x-api-key och äger de
# jobb det skapar. Utan den finns kontot inte.  openssl rand -hex 32
CONDITION_SERVICE_KEY=

# Adressen appen ligger på utåt, t.ex. https://app.loopa.nu. Sätts den skrivs hela länken till det
# publika truth-cardet (LOOPA_PUBLIC_URL/c/LP-XXXX-XXXX) ut i Tradera-annonsen. Utan den står bara
# Loopa-ID:t där, och köparen får söka upp det hos Loopa.
LOOPA_PUBLIC_URL=

# --- Identifiering via Googles AI-läge (SerpApi) — docs/serpapi.md ---------------
# Med nyckeln satt (och en publik adress för bilden, se nedan) identifieras möbeln av Googles AI-läge via
# SerpApi i stället för av servern själv. Utan nyckeln, med LOOPA_SERPAPI=0 eller när dygnstaket är nått
# tar uppladdningen den vanliga vägen — säljaren märker ingenting. Nyckeln läggs bara här, aldrig i chatten.
# SERPAPI_API_KEY=
# LOOPA_SERPAPI=0
# Adressen SerpApi hämtar omslagsbilden från (/api/serpapi/img/…). Utan den används LOOPA_PUBLIC_URL, där
# https://loopa.nu blir https://app.loopa.nu (servern nås där). Lokalt: tunneladressen till bildgatewayen.
# SERPAPI_PUBLIC_URL=https://app.loopa.nu
# Sökningar per dygn och serverprocess (1 kredit styck; en identifiering ≈ 7), och samtal per konto och dygn.
# SERPAPI_DAILY_CAP=200
# SERPAPI_MAX_SESSIONS_PER_USER=30
# Bildkedjan A → C → B för referensbilderna (steg B kostar ≈ 0,3 kr per modell som saknar bild). 0 = av.
# LOOPA_REFERENCE_CHAIN=1

# Ursprung som får läsa API:t från en annan adress. Tomt = bara samma ursprung, vilket räcker när
# servern själv serverar UI:t.  Exempel: https://app.loopa.nu
ALLOWED_ORIGINS=

# --- Adminpanelen ----------------------------------------------------------
# victor@ruiz.se är admin, satt i koden (server/src/admin.ts) — den raden gäller oavsett miljö.
# ADMIN_EMAILS LÄGGER TILL fler adresser, kommaseparerat. Den ersätter inte den inbyggda.
# ADMIN_EMAILS=

# Annonspanelen (/api/admin/annonser) läser samma jobb som allt annat och behöver ingen egen nyckel.
# Mätningen den visar skrivs till server/data/analys/handelser.jsonl — en rad JSON per händelse, utan
# identitet och utan kaka. ANALYS_DATA_DIR flyttar loggen; tom = mappen ovan.
# ANALYS_DATA_DIR=

# Utan den här listar panelen bara konton som syns i jobben, plus de profiler adminens egen token får
# läsa. Med den kommer HELA användarlistan ur Supabase Auth med — även konton som aldrig filmat något.
# Nyckeln är service_role-nyckeln i Supabase (Project Settings -> API). Den ger full åtkomst till
# projektet och får bara ligga på servern, aldrig i webbappen.
# SUPABASE_SERVICE_ROLE_KEY=

# Adoptera jobb utan ägare (skapade före inloggningen) till ett konto. Tomt = de är privata.
LEGACY_JOBS_OWNER=

# --- Produktbilden ---------------------------------------------------------
# Säljarens egen möbel, urklippt mot rent vitt. Det är den bilden sanningskortet och butiken visar;
# utan en produktbild faller båda tillbaka på tillverkarens katalogbild, alltså en NY exemplar av
# modellen, eller på säljarens bildruta med rummet kvar.
#
# INGEN GENERATIV MODELL är inblandad. En segmenteringsmodell svarar på EN fråga — vilka pixlar som
# är möbel — och möbelns egna pixlar går orörda igenom. Det kontrolleras dessutom mätbart i varje
# körning; se server/src/pipeline/bild/kvalitet.ts.
#
# Modellfilerna ligger i server/models/ och hämtas med ./scripts/fetch-models.sh. Registret över
# vilka som finns, vad de kostar i RAM och vad de är bra på står i
# server/src/pipeline/bild/modeller.ts.

# Modellen som bygger omslaget. Förval: birefnet-general (973 MB, bäst kant, ~75 s per bild på
# processor — den körs utanför säljarens väntan). En burk utan en gigabyte att avvara sätter
# isnet-general-use (179 MB). Saknas den valda faller koden nedåt genom RESERVKEDJA: sämre bild,
# aldrig ett kraschat jobb.
# PRODUKTBILD_MODELL=birefnet-general

# Modellen som VÄLJER vilken av säljarens bildrutor omslaget byggs ur. Förval: u2netp (4,4 MB).
# Liten med flit — "vilken ruta visar hela möbeln?" är en mycket lättare fråga än "var går kanten på
# stolsbenet?", och den stora modellen på sex rutor vore nio minuter för ett svar den lilla ger rätt.
# PRODUKTBILD_URVALSMODELL=u2netp

# Trådar per inferens. Förval 1: servern kör besiktningar parallellt, och en modell som tar alla
# kärnor gör varje annat anrop långsammare. Höj bara i skript och benchmarks.
# PRODUKTBILD_TRADAR=1

# Stänger av produktbilden helt. Kortet visar då säljarens bildruta som den är på säljarens EGET
# kort, och katalogbilden publikt. Se COVER_CUTOUT i server/src/config.ts.
# COVER_CUTOUT=0

# --- Butiken ---------------------------------------------------------------
# app.loopa.nu/butik. Fungerar UTAN allt nedan: rutnätet visar då Loopas egna granskade möbler,
# lagret ligger i filer under server/data/butik och köpknappen visas inte alls.

# Kassan. Utan STRIPE_SECRET_KEY finns ingen köpknapp — en knapp som leder till ett fel är sämre än
# ingen knapp. Testnycklar (sk_test_…) räcker för att prova hela flödet.
# STRIPE_SECRET_KEY=

# Webhookens hemlighet, från Stripe Dashboard -> Developers -> Webhooks. UTAN DEN BLIR INGEN ORDER
# BETALD: att köparen skickas tillbaka till tacksidan bevisar ingenting — adressen kan vem som helst
# öppna. Bara en signaturverifierad checkout.session.completed säljer möbeln.
# Lyssna på: checkout.session.completed, checkout.session.expired
# Lokalt:  stripe listen --forward-to localhost:8799/api/butik/webhook
# STRIPE_WEBHOOK_SECRET=

# Tradera som lagerkälla (SOAP v3 SearchService — ett ANNAT API än publiceringens REST v4, men samma
# appnyckel). PÅ som förval när TRADERA_APP_ID/APP_KEY finns. TRADERA_SOURCE=0 stänger av den helt;
# det är kill switchen om villkorsdiskussionen kräver det, och rutnätet fortsätter fungera utan den.
# TRADERA_SOURCE=0

# Hur länge ett Tradera-sökresultat återanvänds, i ms. Skyddar deras anropstak och vårt svarsläge.
# TRADERA_SEARCH_TTL_MS=300000

# Hur länge en möbel hålls medan någon står i kassan. Unika möbler: för kort och köparen tappar den
# mitt i betalningen, för långt och en övergiven kassa låser möbeln för alla andra.
# BUTIK_RESERVATION_MINUTES=15

# Hur ofta utgångna reservationer släpps, i ms.
# BUTIK_SWEEP_INTERVAL_MS=60000

# Hur länge butikens produktindex får vara gammalt, i ms. Kort — en säljare som publicerar ska se
# sin möbel i butiken.
# BUTIK_INDEX_TTL_MS=30000

# Var butikens filer ligger. Tomt = server/data/butik. Sätts av testerna så de inte skriver bland
# skarpa varor; i drift bara intressant om butiken ska ligga på en annan volym än jobben.
# BUTIK_DATA_DIR=

# Butikens tillstånd i Postgres i stället för i filer. Använder SUPABASE_SERVICE_ROLE_KEY ovan och
# tabellerna i server/sql/001_butik.sql — som INTE appliceras automatiskt: schemat ligger i ett
# projekt som delas med vips-buy-sell-hub, och en tjänst som ändrar där vid uppstart kan göra det vid
# fel tillfälle. Kör migrationen för hand först.

# --- Trygg affär: hämtning av annonssidor ------------------------------------
# Serverhämtning av annonsen köparen klistrat in (LINK_FETCH). AV som förval; utan den laddar köparen
# upp egna skärmbilder, vilket alltid fungerar.
# AFFAR_LINK_FETCH=1

# ⚠️ RESPEKTERAR robots.txt SOM FÖRVAL, och det spelar roll: Blocket förbjuder uttryckligen
# automatiserad hämtning utan skriftligt tillstånd ("Crawling blocket.se is prohibited unless you
# have written permission"). Med förvalet avvisas Blocket och köparen ombeds ladda upp skärmbilder.
#
# Sätt bara den här om ni HAR ett skriftligt tillstånd. Namnet är klumpigt med flit.
# AFFAR_LINK_FETCH_IGNORE_ROBOTS=1

# Tidsgräns per hämtning, i ms.
# AFFAR_LINK_TIMEOUT_MS=12000

# --- Tradera-inkorgen: meddelandefunktionen på tradera.com -------------------
# Omläggningen läser säljarens Tradera-inkorg innan en annons tas ner: har en köpare skrivit om den
# ligger den kvar (integrations/tradera/fragor.ts). Sessionen skapas för hand en gång med
# `npm run tradera:logga-in` (reCAPTCHA) och sparas som Playwright-storageState. Saknas filen, eller
# har sessionen gått ut, tas ingen Tradera-annons ner — den nya läggs upp bredvid.
# TRADERA_SESSION=./tradera-session.json

# --- Tradera-posten: Gmail läses var halvtimme ------------------------------
# Bevakaren läser mejlen från Tradera i en Gmail-inkorg. En såld vara blir såld i butiken
# (samma tillståndsmaskin som kassan), frågor och bud hamnar i adminpanelens flik "Tradera-post",
# och ett brev går till TRADERA_MAIL_NOTIFY_TO. Mejlen i Gmail rörs aldrig.
#
# Kontot kräver ett APPLÖSENORD, inte det vanliga: Google-kontot -> Säkerhet -> Tvåstegsverifiering
# -> Applösenord. Saknas någon av de två är bevakaren av, och säger det i loggen vid uppstart.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Vart notiserna går. Förval: Gmail-kontot självt.
# TRADERA_MAIL_NOTIFY_TO=
# Hur ofta inkorgen läses, i minuter. Förval 30.
# TRADERA_MAIL_POLL_MINUTES=30
# Hur långt tillbaka första läsningen går, i dagar. Förval 7. Äldre sålda varor markeras INTE om
# i efterhand utan hamnar i posten som "redan såld" om de redan är det.
# TRADERA_MAIL_SINCE_DAYS=7
# Kill switch utan att ta bort kontot.
# TRADERA_MAIL_WATCH=0
#
# Notiserna går via utskicket. Med `gmail` skickas de på riktigt genom samma konto (Gmail SMTP);
# förvalet `file` lägger dem i /outbox. Se server/src/notify/outbox.ts.
# EMAIL_PROVIDER=gmail


# --- Blocket: publicering med robot ------------------------------------------
# Blocket har inget API för att lägga upp annonser. Publiceringen sker genom att Playwright klickar i
# Blockets eget formulär, inloggad som kontot nedan.
#
# OBS: Blockets villkor förbjuder automatiserad åtkomst utan skriftligt tillstånd (se noten om
# AFFAR_LINK_FETCH_IGNORE_ROBOTS ovan). Slå på det här bara för ett konto ni själva äger och har rätt
# att automatisera.

# Playwrights storageState, skapad genom en INLOGGNING FÖR HAND. Blocket har passwordless inloggning
# och stöder inte lösenord — sessionen går inte att skapa i kod. BankID roterar den dessutom, så den
# måste exporteras om efter varje ny legitimering.
# BLOCKET_SESSION=./blocket-session.json

# ELLER: sessionen i samma form som railway-proxy-company-blocket läste den (vips-buy-sell-hub). Värdet
# från Railway → railway-proxy-company-blocket → Variables går att klistra in rakt av, utan ny inloggning,
# så länge sessionen inte gått ut. Skrivs till server/data/blocket/session.json vid första användning;
# en session som Blocket roterat skrivs inte över vid omstart, bara när värdet här ändras.
# BLOCKET_STORAGE_STATE_GZIP=H4sIAAAA...
# (eller BLOCKET_STORAGE_STATE={"cookies":[...],"origins":[...]})

# POSTNUMRET ÄR SÄLJARENS och sätts inte här. Det tas ur säljarens konto (adressen från registreringen):
# på jobbet när säljaren trycker "Sälj med Loopa", annars med SUPABASE_SERVICE_ROLE_KEY vid godkännandet.
# Utan nyckeln publiceras bara jobb där säljaren tryckt efter att det här infördes.

# SKARPT LÄGE. Utan den här är varje körning en torrkörning: allt fylls i, men sista knappen trycks
# aldrig. Förvalet är omvänt mot Tradera med flit — en Blocket-annons går inte att ta ner
# automatiskt, och det som inte går att ångra ska inte vara förvalt.
# BLOCKET_PUBLICERA=1

# Prisroboten (integrations/blocket/pris.ts): när prisstegen sänkt möbeln ändrar roboten priset på
# Blocket-annonsen — direkt på /recommerce/create/<annons-id> (Blockets eget redigeringsformulär),
# med en rubrikvakt så att den aldrig sparar på fel annons. EGEN BRYTARE: 1 = på även när
# publiceringen torrkör (en prisändring går att ångra, en publicering går inte att ta ner), 0 = av,
# osatt = följer BLOCKET_PUBLICERA. Av = Blocket står som "ändra för hand" i panelen och ett brev går
# till admin per sänkning. Första skarpa körningen görs för hand: npm run blocket:pris -- <jobId> [--skarpt]
# BLOCKET_PRIS_ROBOT=1

# Veckans omläggning (integrations/omlaggning.ts): vid veckosänkningen tas annonsen NER och läggs upp
# PÅ NYTT med det nya priset, i stället för att priset ändras på den annons som ligger ute. Lista med
# kanaler; osatt = tradera,blocket, 0 = av överallt (då ändras priset på plats som förut). Tradera
# läggs inte om när annonsen har bud eller är såld. Blocket läggs om när BLOCKET_PUBLICERA=1 (och
# BLOCKET_TA_BORT_ROBOT inte är 0): den nya annonsen förbereds till sista knappen, den gamla tas ner,
# den nya publiceras. Kräver Blocket BankID tas ingenting ner — admin får ett brev. Kommer annonsen
# inte upp igen får admin ett brev, och servern försöker igen om 20 min och sedan var sjätte timme.
# PRIS_OMLAGGNING=tradera,blocket

# Borttagningsroboten (integrations/blocket/borttagning.ts): Mina annonser → kortets meny → Ta bort,
# med rubrikvakt, aldrig "Markera som såld", och kontroll efteråt att annonsen inte står bland de
# aktiva. Prövad skarpt 2026-10-20. 1 = på, 0 = av (Blocket-priset ändras då på plats som förut),
# osatt = följer BLOCKET_PUBLICERA. Torrkörning: npm run blocket:ta-bort -- <jobId>  (klickar inget)
# BLOCKET_TA_BORT_ROBOT=0

# Synlig webbläsare. MÅSTE vara på när BankID kan komma upp: legitimeringen sker i en app i handen på
# en människa, och en osynlig webbläsare ger dem ingenting att titta på.
# BLOCKET_SYNLIG=1

# Sessionsvakten (integrations/blocket/vakt.ts): kontrollerar med det här mellanrummet, i minuter, att
# sessionen fortfarande gäller — Mina annonser, inget formulär — och mejlar ADMIN_EMAILS EN gång när
# den gått ut. Beskedet skrivs till server/data/blocket/halsa.json och står i panelens Kanallista.
# Förval 720 (var tolfte timme). 0 stänger av. Första kontrollen två minuter efter start.
# BLOCKET_VAKT_MINUTER=720

# Robotarnas dagliga hälsokontroll (robotHalsa.ts): Blocket, Tradera och Facebook — inloggningarna,
# Traderas nycklar, Gmail-bevakaren, och publiceringar som föll, fastnat eller hänger nere efter en
# omläggning. Rapporten står under Robotar i panelen; ADMIN_EMAILS mejlas när något inte är grönt och
# en gång när det blivit grönt igen. Klockslag i svensk tid, förval 07:00. "av" stänger av.
# Kör för hand: npm run robotar:halsa (lägg till -- --brev för att även mejla).
# ROBOT_HALSA_TID=07:00
# ROBOT_HALSA_BREV=alltid      # mejla varje morgon, även när allt är grönt

# Säljarens siffror från marknadsplatserna (kanalStatistik.ts), i annonsvyn under "Så går annonsen".
# Robotarna läser Traderas säljarsidor (visningar, bevakare, bud — kräver TRADERA_SESSION, samma som
# inkorgen) och Blockets statistiksida per annons (klick, besökare, kontakter, favoriter, bevakningsmejl,
# historik per dag). Delar Blocket-låset med publiceringen. Mellanrum i timmar, förval 3, 0 stänger av.
# Kör för hand: npm run statistik:svep
# KANAL_STATISTIK_TIMMAR=3

# Felskärmbilder från en körning som stoppades hamnar i server/data/blocket/fel-<jobId>.png. Där ser
# man om det var en spärrsida, en cookiebanner eller ett ombyggt formulär — stegloggen på jobbet säger
# bara VAR det stannade. Katalogen pekas om med BLOCKET_DATA_DIR (testerna gör det).

# Peka om hela flödet till en attrapp i stället för blocket.se. Används av tests/blocketAttrapp.ts.
# BLOCKET_BAS_URL=http://127.0.0.1:5000

# --- Adressförslag i registreringen ------------------------------------------
# Google Places (New): man skriver gatuadressen, väljer ett förslag, och postnummer och ort fylls i.
# Anropen går via servern (server/src/adress.ts) — nyckeln ska ALDRIG till webbappen.
# Skapa nyckeln i Google Cloud Console -> APIs & Services -> Credentials, slå på "Places API (New)"
# och begränsa nyckeln till just det API:t. Kräver ett betalkonto; en session (förslag + val) räknas
# som ett anrop mot den fria kvoten. Utan nyckeln är fälten som förut: man skriver själv.
# Knappen "Använd min nuvarande adress" gör om telefonens position till en adress med Geocoding API.
# Slå på det också, på SAMMA nyckel, och lägg till det i nyckelns API-begränsning. Utan det svarar
# knappen "Platsen gick inte att hämta" och förslagen fungerar som vanligt.
# GOOGLE_MAPS_API_KEY=

# --- Facebook: distribution till Marketplace och Stockholms köp/sälj-grupper ---
# Loopa är sanningen: Facebook-inläggen pekar tillbaka på produktsidan (/butik/objekt/<loopaId>), och
# köpet sker på Loopa. Roboten (Playwright, integrations/facebook/) söker grupper, läser regler, ansöker
# om medlemskap, och lägger ut varje möbel som blir live i butiken — på Marketplace och i grupper som är
# medlem + tillåter annonser.
#
# INGEN INLOGGNING I KOD. Kör `npm run facebook:login` en gång: ett synligt Chromium öppnas, du loggar in,
# och sessionen bor i webbläsarprofilen nedan. Inget lösenord sparas. Vanlig Chromium — inga proxyer,
# ingen fingeravtrycksmaskering. Visar Facebook en kontrollpunkt, CAPTCHA eller spärr STANNAR roboten,
# skriver NEEDS_MANUAL_ACTION (panelen -> Facebook -> Publiceringar) och väntar på en människa.

# Hela integrationen. Av som förval: en utrullning ändrar ingenting förrän den här står på 1.
# FACEBOOK_ENABLED=1

# live = riktiga facebook.com (förval). mock = attrappen i tests/ (FACEBOOK_BASE_URL måste peka dit).
# FACEBOOK_MODE=live

# TORRKÖRNING ÄR FÖRVALET. Allt fylls i på riktiga Facebook — sökning, regler, medlemskap,
# Marketplace-formuläret, gruppens skrivruta — men Publicera trycks aldrig; posten blir WOULD_PUBLISH
# med skärmbild. Bara ett uttryckligt FACEBOOK_DRY_RUN=false publicerar på riktigt.
# FACEBOOK_DRY_RUN=true

# Upptäckten av grupper (läsning, på som förval när integrationen är på).
# FACEBOOK_AUTO_DISCOVER=1

# Automatiska medlemsansökningar. AV som förval — det är en riktig skrivning. Utan den ansöker roboten
# bara när en admin pekar ut gruppen i panelen (Grupper -> Ansök om medlemskap).
# FACEBOOK_AUTO_JOIN=0

# Kanalerna var för sig. Panelen har dessutom pausknappar som inte kräver omstart.
# FACEBOOK_MARKETPLACE_ENABLED=1
# FACEBOOK_GROUP_PUBLISHING_ENABLED=1

# Webbläsarprofilen med sessionen. Förval server/data/facebook/profile (gitignorerad). Lagret —
# grupper, köer, session, inställningar, skärmbilder — ligger i FACEBOOK_DATA_DIR, förval server/data/facebook.
# FACEBOOK_PROFILE_DIR=
# FACEBOOK_DATA_DIR=

# Kontoräcket: det Facebook-konto (numeriskt id, c_user) profilen SKA vara inloggad på. Satt = ingen
# arbetare kör om profilen bär ett annat konto. Två konton med samma namn på samma maskin hände 2026-09-25.
# FACEBOOK_ACCOUNT_ID=

# Synlig webbläsare för arbetarna (inloggningen är alltid synlig).
# FACEBOOK_HEADFUL=0

# Skyddsräcken — konservativa tal, inte ett sätt att undvika upptäckt.
# FACEBOOK_MAX_JOINS_PER_DAY=3
# FACEBOOK_MAX_GROUP_POSTS_PER_DAY=10
# FACEBOOK_MAX_MARKETPLACE_PER_DAY=5
# FACEBOOK_MIN_SECONDS_BETWEEN_WRITES=120
# Grupper per annons — ratten för utrullningen (3 → 5 → 10). Panelens inställning skriver över.
# FACEBOOK_MAX_GROUPS_PER_LISTING=3
# Minsta paus mellan två Loopa-inlägg i samma grupp, i timmar. Gruppens egen regel vinner när den är strängare.
# FACEBOOK_GROUP_COOLDOWN_HOURS=24
# FACEBOOK_MIN_RELEVANCE_TO_JOIN=60
# FACEBOOK_MIN_MEMBERS_TO_JOIN=300
# Regler äldre än så här läses om före en publicering, i timmar.
# FACEBOOK_RULES_MAX_AGE_HOURS=72
# FACEBOOK_DISCOVERY_INTERVAL_MINUTES=720
# FACEBOOK_DISCOVERY_QUERIES_PER_RUN=8
# FACEBOOK_MEMBERSHIP_CHECK_MINUTES=360
# FACEBOOK_PUBLISH_TICK_SECONDS=60

# Peka om hela flödet till attrappen i tests/facebookAttrapp.ts. Aldrig i drift.
# FACEBOOK_BASE_URL=http://127.0.0.1:5000
