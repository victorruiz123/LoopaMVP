# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Public API (/v1/condition). Without it the API refuses every request — it never runs open.
# Generate one with:  openssl rand -hex 32
CONDITION_API_KEY=

# Optional — defaults shown
PORT=8799

# --- Röstrundan (VOICE-TOUR.md) --------------------------------------------
# Aqua Voice Avalon-API:t transkriberar rundans ljud ($0,39/ljudtimme). Nyckel från
# https://aquavoice.com/avalon-api. Utan den svarar /api/voice-tour/transcribe 503 med
# klartext — ett transkript hittas aldrig på.
AQUA_API_KEY=

# --- Prismotorn (Price_engine) --------------------------------------------
# Skickmotorn frågar prismotorn vad möbeln är värd GIVET skadorna. Är den inte
# igång blir svaret ett skickresultat utan pris — aldrig ett misslyckat jobb.
# Starta den med `npm run price:dev`.
PRICE_ENGINE_URL=http://127.0.0.1:8000

# Bara om prismotorn startats med PRICE_ENGINE_API_KEY satt.
# PRICE_ENGINE_API_KEY=

# Hur länge skickmotorn väntar på ett prissvar, i ms. Standard 45000.
# PRICE_ENGINE_TIMEOUT_MS=45000

# 1 = skicka en bildruta så prismotorn klassificerar möbeltypen ur den. AV som
# standard: det anropet görs utan timeout på Python-sidan och hänger. Typen
# härleds ändå ur modellnamnet.
# PRICE_ENGINE_USE_IMAGE=1

# --- Omslaget --------------------------------------------------------------
# Kortets bild är säljarens egen möbel, urklippt ur bildrutan och lagd på vitt
# (server/src/pipeline/bild/). Det kostar ingen extra modellavgift, och körs utanför
# säljarens väntan. Sätt till 0 för att stänga av det: kortet visar då bildrutan
# som den togs, precis som när urklippet inte går att göra.
# COVER_CUTOUT=0

# --- Tradera ---------------------------------------------------------------
# Publicerar truth-cardet som en riktig annons på Loopas Tradera-konto. Saknas
# någon av de fyra göms knappen i truth-cardet — integrationen är frånkopplad,
# inte trasig. App-id och app-key finns i Developer Center (Applications ->
# Keys); user-id och token faller ut ur token-login-steget.
TRADERA_APP_ID=
TRADERA_APP_KEY=
TRADERA_USER_ID=
TRADERA_USER_TOKEN=

# Valfria.
#
# Annonstyp. Standard är fast pris — "Endast Köp Nu" till priset på kortet.
# Sätt till "auction" om Tradera avvisar med "only auctions allowed": ett nytt
# eller obetygsatt privatkonto är restricted och får bara lägga upp auktioner.
# TRADERA_LISTING_MODE=fixed
#
# Auktionslängd i dagar, används bara när läget är "auction". Minst 7 på ett
# restricted konto. En Köp Nu-annons får sin längd av Tradera.
# TRADERA_AUCTION_DAYS=7
#
# Vilka betalsätt annonsen ska erbjuda. Standard är kontots enda aktiverade:
# 16384 = Swish / Kort / PayPal. Se GET /v4/users/me/payment-options.
# TRADERA_PAYMENT_OPTION_IDS=16384

# --- Prisstegen ------------------------------------------------------------
# Säljaren sätter ett startpris och ett golv på prisvyn, och servern sänker
# priset på den publicerade annonsen 15 % i veckan tills golvet nås. Stegen är
# på så fort Tradera är konfigurerat — de två variablerna nedan finns bara för
# att kunna se hela förloppet i en demo utan att vänta en månad på fjärde steget.
#
# Tiden mellan två sänkningar. Standard: en vecka (604800000 ms).
# PRICE_LADDER_INTERVAL_MS=604800000
#
# Hur ofta servern tittar efter förfallna sänkningar. Standard: 15 min.
# PRICE_LADDER_TICK_MS=900000

# Signerar bildkakan som låter <img> hämta jobbets bildrutor. Utan den slumpas en per start, och
# kakorna slutar gälla vid varje omstart.  openssl rand -hex 32
MEDIA_COOKIE_SECRET=

# Maskinkonto för mätharnessen (tests/candidate-path.ts m.fl.). Skickas som x-api-key och äger de
# jobb det skapar. Utan den finns kontot inte.  openssl rand -hex 32
CONDITION_SERVICE_KEY=

# Adressen appen ligger på utåt, t.ex. https://app.loopa.nu. Sätts den skrivs hela länken till det
# publika truth-cardet (LOOPA_PUBLIC_URL/c/LP-XXXX-XXXX) ut i Tradera-annonsen. Utan den står bara
# Loopa-ID:t där, och köparen får söka upp det hos Loopa.
# Har roten flyttat till marknadsdomänen? loopa.nu/ visar marknadssajtens företagssida fram till
# lansering, så app.loopa.nu/ måste fortsätta svara med säljflödet — annars går det inte att nå
# från någon adress alls. Sätt till 1 SAMTIDIGT som omdirigeringsregeln tas bort i Cloudflare.
# LOOPA_ROT_FLYTTAD=1

LOOPA_PUBLIC_URL=

# Ursprung som får läsa API:t från en annan adress. Tomt = bara samma ursprung, vilket räcker när
# servern själv serverar UI:t.  Exempel: https://app.loopa.nu
ALLOWED_ORIGINS=

# --- Adminpanelen ----------------------------------------------------------
# victor@ruiz.se är admin, satt i koden (server/src/admin.ts) — den raden gäller oavsett miljö.
# ADMIN_EMAILS LÄGGER TILL fler adresser, kommaseparerat. Den ersätter inte den inbyggda.
# ADMIN_EMAILS=

# Annonspanelen (/api/admin/annonser) läser samma jobb som allt annat och behöver ingen egen nyckel.
# Mätningen den visar skrivs till server/data/analys/handelser.jsonl — en rad JSON per händelse, utan
# identitet och utan kaka. ANALYS_DATA_DIR flyttar loggen; tom = mappen ovan.
# ANALYS_DATA_DIR=

# Utan den här listar panelen bara konton som syns i jobben, plus de profiler adminens egen token får
# läsa. Med den kommer HELA användarlistan ur Supabase Auth med — även konton som aldrig filmat något.
# Nyckeln är service_role-nyckeln i Supabase (Project Settings -> API). Den ger full åtkomst till
# projektet och får bara ligga på servern, aldrig i webbappen.
# SUPABASE_SERVICE_ROLE_KEY=

# Adoptera jobb utan ägare (skapade före inloggningen) till ett konto. Tomt = de är privata.
LEGACY_JOBS_OWNER=

# --- Produktbilden ---------------------------------------------------------
# Säljarens egen möbel, urklippt mot rent vitt. Det är den bilden sanningskortet och butiken visar;
# utan en produktbild faller båda tillbaka på tillverkarens katalogbild, alltså en NY exemplar av
# modellen, eller på säljarens bildruta med rummet kvar.
#
# INGEN GENERATIV MODELL är inblandad. En segmenteringsmodell svarar på EN fråga — vilka pixlar som
# är möbel — och möbelns egna pixlar går orörda igenom. Det kontrolleras dessutom mätbart i varje
# körning; se server/src/pipeline/bild/kvalitet.ts.
#
# Modellfilerna ligger i server/models/ och hämtas med ./scripts/fetch-models.sh. Registret över
# vilka som finns, vad de kostar i RAM och vad de är bra på står i
# server/src/pipeline/bild/modeller.ts.

# Modellen som bygger omslaget. Förval: birefnet-general (973 MB, bäst kant, ~75 s per bild på
# processor — den körs utanför säljarens väntan). En burk utan en gigabyte att avvara sätter
# isnet-general-use (179 MB). Saknas den valda faller koden nedåt genom RESERVKEDJA: sämre bild,
# aldrig ett kraschat jobb.
# PRODUKTBILD_MODELL=birefnet-general

# Modellen som VÄLJER vilken av säljarens bildrutor omslaget byggs ur. Förval: u2netp (4,4 MB).
# Liten med flit — "vilken ruta visar hela möbeln?" är en mycket lättare fråga än "var går kanten på
# stolsbenet?", och den stora modellen på sex rutor vore nio minuter för ett svar den lilla ger rätt.
# PRODUKTBILD_URVALSMODELL=u2netp

# Trådar per inferens. Förval 1: servern kör besiktningar parallellt, och en modell som tar alla
# kärnor gör varje annat anrop långsammare. Höj bara i skript och benchmarks.
# PRODUKTBILD_TRADAR=1

# Stänger av produktbilden helt. Kortet visar då säljarens bildruta som den är på säljarens EGET
# kort, och katalogbilden publikt. Se COVER_CUTOUT i server/src/config.ts.
# COVER_CUTOUT=0

# --- Butiken ---------------------------------------------------------------
# app.loopa.nu/butik. Fungerar UTAN allt nedan: rutnätet visar då Loopas egna granskade möbler,
# lagret ligger i filer under server/data/butik och köpknappen visas inte alls.

# Kassan. Utan STRIPE_SECRET_KEY finns ingen köpknapp — en knapp som leder till ett fel är sämre än
# ingen knapp. Testnycklar (sk_test_…) räcker för att prova hela flödet.
# STRIPE_SECRET_KEY=

# Webhookens hemlighet, från Stripe Dashboard -> Developers -> Webhooks. UTAN DEN BLIR INGEN ORDER
# BETALD: att köparen skickas tillbaka till tacksidan bevisar ingenting — adressen kan vem som helst
# öppna. Bara en signaturverifierad checkout.session.completed säljer möbeln.
# Lyssna på: checkout.session.completed, checkout.session.expired
# Lokalt:  stripe listen --forward-to localhost:8799/api/butik/webhook
# STRIPE_WEBHOOK_SECRET=

# Tradera som lagerkälla (SOAP v3 SearchService — ett ANNAT API än publiceringens REST v4, men samma
# appnyckel). PÅ som förval när TRADERA_APP_ID/APP_KEY finns. TRADERA_SOURCE=0 stänger av den helt;
# det är kill switchen om villkorsdiskussionen kräver det, och rutnätet fortsätter fungera utan den.
# TRADERA_SOURCE=0

# Hur länge ett Tradera-sökresultat återanvänds, i ms. Skyddar deras anropstak och vårt svarsläge.
# TRADERA_SEARCH_TTL_MS=300000

# Hur länge en möbel hålls medan någon står i kassan. Unika möbler: för kort och köparen tappar den
# mitt i betalningen, för långt och en övergiven kassa låser möbeln för alla andra.
# BUTIK_RESERVATION_MINUTES=15

# Hur ofta utgångna reservationer släpps, i ms.
# BUTIK_SWEEP_INTERVAL_MS=60000

# Hur länge butikens produktindex får vara gammalt, i ms. Kort — en säljare som publicerar ska se
# sin möbel i butiken.
# BUTIK_INDEX_TTL_MS=30000

# Var butikens filer ligger. Tomt = server/data/butik. Sätts av testerna så de inte skriver bland
# skarpa varor; i drift bara intressant om butiken ska ligga på en annan volym än jobben.
# BUTIK_DATA_DIR=

# Butikens tillstånd i Postgres i stället för i filer. Använder SUPABASE_SERVICE_ROLE_KEY ovan och
# tabellerna i server/sql/001_butik.sql — som INTE appliceras automatiskt: schemat ligger i ett
# projekt som delas med vips-buy-sell-hub, och en tjänst som ändrar där vid uppstart kan göra det vid
# fel tillfälle. Kör migrationen för hand först.

# --- Trygg affär: hämtning av annonssidor ------------------------------------
# Serverhämtning av annonsen köparen klistrat in (LINK_FETCH). AV som förval; utan den laddar köparen
# upp egna skärmbilder, vilket alltid fungerar.
# AFFAR_LINK_FETCH=1

# ⚠️ RESPEKTERAR robots.txt SOM FÖRVAL, och det spelar roll: Blocket förbjuder uttryckligen
# automatiserad hämtning utan skriftligt tillstånd ("Crawling blocket.se is prohibited unless you
# have written permission"). Med förvalet avvisas Blocket och köparen ombeds ladda upp skärmbilder.
#
# Sätt bara den här om ni HAR ett skriftligt tillstånd. Namnet är klumpigt med flit.
# AFFAR_LINK_FETCH_IGNORE_ROBOTS=1

# Tidsgräns per hämtning, i ms.
# AFFAR_LINK_TIMEOUT_MS=12000

# --- Blocket: publicering med robot ------------------------------------------
# Blocket har inget API för att lägga upp annonser. Publiceringen sker genom att Playwright klickar i
# Blockets eget formulär, inloggad som kontot nedan.
#
# OBS: Blockets villkor förbjuder automatiserad åtkomst utan skriftligt tillstånd (se noten om
# AFFAR_LINK_FETCH_IGNORE_ROBOTS ovan). Slå på det här bara för ett konto ni själva äger och har rätt
# att automatisera.

# Playwrights storageState, skapad genom en INLOGGNING FÖR HAND. Blocket har passwordless inloggning
# och stöder inte lösenord — sessionen går inte att skapa i kod. BankID roterar den dessutom, så den
# måste exporteras om efter varje ny legitimering.
# BLOCKET_SESSION=./blocket-session.json

# Annonsens postnummer. Blocket kräver det; Loopa vet inte var möbeln står.
# BLOCKET_POSTNUMMER=11234

# SKARPT LÄGE. Utan den här är varje körning en torrkörning: allt fylls i, men sista knappen trycks
# aldrig. Förvalet är omvänt mot Tradera med flit — en Blocket-annons går inte att ta ner
# automatiskt, och det som inte går att ångra ska inte vara förvalt.
# BLOCKET_PUBLICERA=1

# Synlig webbläsare. MÅSTE vara på när BankID kan komma upp: legitimeringen sker i en app i handen på
# en människa, och en osynlig webbläsare ger dem ingenting att titta på.
# BLOCKET_SYNLIG=1

# Peka om hela flödet till en attrapp i stället för blocket.se. Används av tests/blocketAttrapp.ts.
# BLOCKET_BAS_URL=http://127.0.0.1:5000
