# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Public API (/v1/condition). Without it the API refuses every request — it never runs open.
# Generate one with:  openssl rand -hex 32
CONDITION_API_KEY=

# Optional — defaults shown
PORT=8799

# --- Prismotorn (Price_engine) --------------------------------------------
# Skickmotorn frågar prismotorn vad möbeln är värd GIVET skadorna. Är den inte
# igång blir svaret ett skickresultat utan pris — aldrig ett misslyckat jobb.
# Starta den med `npm run price:dev`.
PRICE_ENGINE_URL=http://127.0.0.1:8000

# Bara om prismotorn startats med PRICE_ENGINE_API_KEY satt.
# PRICE_ENGINE_API_KEY=

# Hur länge skickmotorn väntar på ett prissvar, i ms. Standard 45000.
# PRICE_ENGINE_TIMEOUT_MS=45000

# 1 = skicka en bildruta så prismotorn klassificerar möbeltypen ur den. AV som
# standard: det anropet görs utan timeout på Python-sidan och hänger. Typen
# härleds ändå ur modellnamnet.
# PRICE_ENGINE_USE_IMAGE=1

# --- Tradera ---------------------------------------------------------------
# Publicerar truth-cardet som en riktig annons på Loopas Tradera-konto. Saknas
# någon av de fyra göms knappen i truth-cardet — integrationen är frånkopplad,
# inte trasig. App-id och app-key finns i Developer Center (Applications ->
# Keys); user-id och token faller ut ur token-login-steget.
TRADERA_APP_ID=
TRADERA_APP_KEY=
TRADERA_USER_ID=
TRADERA_USER_TOKEN=

# Valfria.
#
# Annonstyp. Standard är fast pris — "Endast Köp Nu" till priset på kortet.
# Sätt till "auction" om Tradera avvisar med "only auctions allowed": ett nytt
# eller obetygsatt privatkonto är restricted och får bara lägga upp auktioner.
# TRADERA_LISTING_MODE=fixed
#
# Auktionslängd i dagar, används bara när läget är "auction". Minst 7 på ett
# restricted konto. En Köp Nu-annons får sin längd av Tradera.
# TRADERA_AUCTION_DAYS=7
#
# Vilka betalsätt annonsen ska erbjuda. Standard är kontots enda aktiverade:
# 16384 = Swish / Kort / PayPal. Se GET /v4/users/me/payment-options.
# TRADERA_PAYMENT_OPTION_IDS=16384
