{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // DOM finns här för Blocket-publiceringen: koden inuti page.evaluate() kör i webbläsaren, inte i
    // Node, och utan DOM-typerna är Element, ShadowRoot och HTMLSelectElement okända namn. Se
    // integrations/blocket/browser.ts. Servern har fortfarande ingen DOM — typerna är bara typer.
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
